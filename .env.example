# Copy to .env and fill in. .env is gitignored.

# --- Models (Vertex AI, personal GCP project) -------------------------------
# No API key: the app signs in with Google Application Default Credentials
# (`gcloud auth application-default login` locally, the service account on Cloud Run).
GCP_PROJECT_ID=your-personal-project-id
VERTEX_REGION=global
# gemini (default; Google's own models, no access request) | anthropic (needs Claude access in Model Garden
# and `pip install -e ".[claude]"`)
LLM_PROVIDER=gemini
# Model IDs as listed in Vertex AI Model Garden.
# Judge: high volume, cheapest model. Editor: writes the teaching-style brief, where a slightly stronger
# model explains better; gemini-3.8-flash ($0.75/$3.75) is the next step up.
MODEL_JUDGE=gemini-3.1-flash-lite
MODEL_EDITOR=gemini-3.5-flash-lite

# --- Spending guard (the "button") ------------------------------------------------
# Model calls are OFF until you set this to true. `ainews check` works either way (it costs < $0.01).
AINEWS_LLM_ENABLED=false
# Hard caps, checked before every model call against the worst case (prompt + max output tokens).
# When a cap would be exceeded, the call is not made and the brief falls back to the no-LLM digest.
AINEWS_MAX_USD_PER_RUN=0.30
AINEWS_MAX_USD_PER_DAY=0.75
AINEWS_MAX_USD_PER_MONTH=10
# The day starts at local midnight (TZ). The jobs lane runs first and leaves this much of the day's cap for the brief.
AINEWS_BRIEF_RESERVE_USD=0.15
# How far back a brief may reach for stories (deployed, infra/deploy.sh sets it from its schedule).
AINEWS_BRIEF_LOOKBACK_HOURS=26
# At most this many stories are sent to the judge per run.
AINEWS_MAX_JUDGE_STORIES=120
# Jobs lane: postings the model reads per `ainews jobs` run (about $0.001 each).
AINEWS_MAX_JOBS_EXTRACT=200

# --- The voice message ---------------------------------------------------------------
# With `brief --send` / `run --send`, the brief opens with one Telegram voice message: a spoken overview the
# narrator model writes from the brief (prompts/narrator.md), read by Gemini TTS (about $0.12 for 7 minutes;
# needs opusenc from opus-tools). "off" sends text only.
AINEWS_VOICE=brief
AINEWS_VOICE_MINUTES=7
MODEL_NARRATOR=gemini-3.8-flash
MODEL_VOICE=gemini-2.5-flash-tts
# A prebuilt Gemini TTS voice, e.g. Charon (informative), Kore (firm), Puck (upbeat), Iapetus (clear).
AINEWS_VOICE_NAME=Charon
# Caps of its own, outside the ones above, checked against the worst case before reading: when one would
# be exceeded, the brief goes out as text only.
AINEWS_VOICE_MAX_USD_PER_BRIEF=0.30
AINEWS_VOICE_MAX_USD_PER_MONTH=3

# --- Telegram ------------------------------------------------------------------
# Bot token from @BotFather; chat ID of the channel (e.g. -100123...) or @channelusername.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional --------------------------------------------------------------------
# Free Hugging Face read token: higher rate limits on the Daily Papers API.
HF_TOKEN=

# --- Local paths (defaults shown) -----------------------------------------------
AINEWS_DB=data/ainews.sqlite
AINEWS_PROFILE=private/profile.md
AINEWS_OUT=out

# Deployment (infra/deploy.sh): the time zone of the schedules and message dates
# AINEWS_TZ=Europe/London
