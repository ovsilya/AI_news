# Copy to .env and fill in. .env is gitignored.

# --- Models (Vertex AI, personal GCP project) -------------------------------
# No Anthropic API key: the app signs in with Google Application Default Credentials
# (`gcloud auth application-default login` locally, the service account on Cloud Run).
GCP_PROJECT_ID=your-personal-project-id
VERTEX_REGION=global
# Model IDs as listed in Vertex AI Model Garden.
MODEL_JUDGE=claude-haiku-5-5
MODEL_EDITOR=claude-opus-5-5

# --- Spending guard (the "button") ------------------------------------------------
# Model calls are OFF until you set this to true. `ainews check` works either way (it costs < $0.01).
AINEWS_LLM_ENABLED=false
# Hard caps, checked before every model call against the worst case (prompt + max output tokens).
# When a cap would be exceeded, the call is not made and the brief falls back to the no-LLM digest.
AINEWS_MAX_USD_PER_RUN=0.75
AINEWS_MAX_USD_PER_DAY=1.50
AINEWS_MAX_USD_PER_MONTH=20
# At most this many stories are sent to the judge per run.
AINEWS_MAX_JUDGE_STORIES=120

# --- Telegram ------------------------------------------------------------------
# Bot token from @BotFather; chat ID of the channel (e.g. -100123...) or @channelusername.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional --------------------------------------------------------------------
# Free Hugging Face read token: higher rate limits on the Daily Papers API.
HF_TOKEN=

# --- Local paths (defaults shown) -----------------------------------------------
AINEWS_DB=data/ainews.sqlite
AINEWS_PROFILE=private/profile.md
AINEWS_OUT=out
